# mixum-ctl —— mixumOS 主机侧 CLI(文件传输/任务/快照/显示)。
#
# Rust 版从 rust/crates/mixum-ctl 原生构建;源码树由
# dist/repo/container-build.sh 同步到 $startdir/rust。
pkgname=mixum-ctl
pkgver=0.1.5
pkgrel=1
pkgdesc="mixumOS 主机侧 CLI:文件传输/任务/快照/显示"
arch=(aarch64 x86_64)
url="https://github.com/mixumos/mixumos"
license=('Apache-2.0')
depends=(glibc gcc-libs)
makedepends=(rust)
source=()
sha256sums=()

prepare() {
	export CARGO_HOME="${MIXUM_CARGO_HOME:-$startdir/.cargo-home}"
	cd "$startdir/rust"
	cargo fetch --locked 2>/dev/null || cargo fetch
}

build() {
	export CARGO_HOME="${MIXUM_CARGO_HOME:-$startdir/.cargo-home}"
	export CARGO_TARGET_DIR="${MIXUM_CARGO_TARGET_DIR:-$startdir/rust/target}"
	cd "$startdir/rust"
	cargo build --release --locked -p mixum-ctl
}

check() {
	export CARGO_HOME="${MIXUM_CARGO_HOME:-$startdir/.cargo-home}"
	export CARGO_TARGET_DIR="${MIXUM_CARGO_TARGET_DIR:-$startdir/rust/target}"
	cd "$startdir/rust"
	cargo test --release -p mixum-ctl -q
}

package() {
	install -Dm755 "${MIXUM_CARGO_TARGET_DIR:-$startdir/rust/target}/release/mixum-ctl" \
		"$pkgdir/usr/bin/mixum-ctl"
	install -Dm644 "$startdir/README.md" "$pkgdir/usr/share/doc/mixum-ctl/README.md"
}
