# mixcomp —— mixumOS 的魔改 Wayland 合成器(wlroots 0.18)。
# 源码来自 monorepo 的 mixcomp/ 子目录;构建容器由 dist/repo/container-build.sh
# 先把仓库做成独立裸仓库 /build/src(worktree 的 .git 指向宿主机,容器内
# 断链,不能直接当 git 源);正式发布时换成固定 tag 的 sdist + sha256,
# 见 docs/distro.md「版本与发布」。
pkgname=mixcomp
pkgver=0.1.3
pkgrel=1
pkgdesc="mixumOS 的魔改 Wayland 合成器:每窗口独立虚拟输出,JPEG 帧流 + 输入注入"
arch=(aarch64 x86_64)
url="https://github.com/mixumos/mixumos"
license=('Apache-2.0')
depends=(wlroots0.18 libjpeg-turbo libpng json-c libxkbcommon wayland openh264)
# wlroots0.18 是 mixum 仓库自建包(官方源已无 0.18,见该包注释),
# 构建容器经 [mixum] 源认领,由 container-build.sh 保证先于本包入库。
makedepends=(git wayland-protocols)
# 构建脚本由环境变量 _commit 固定到当前提交;手工 makepkg 时退回 HEAD。
_commit=${_commit:-HEAD}
source=("$pkgname::git+file:///build/src#commit=${_commit}")
sha256sums=('SKIP')

build() {
	cd "$pkgname/mixcomp"
	# 源码树里混有历史误提交的 .o 文件(架构不定),先清场再编,
	# 避免跨架构构建链到错误架构的目标文件
	make clean >/dev/null 2>&1 || true
	# xdg-shell-protocol.h 由 wlroots 头文件按相对路径引用,部分发行版的
	# wlroots 包不带它(e2e 的 Dockerfile 是生成进系统头文件目录);
	# 这里生成进源码树,用 CPATH 交给 gcc,不写系统目录。
	mkdir -p gen-protocol
	wayland-scanner server-header \
		/usr/share/wayland-protocols/stable/xdg-shell/xdg-shell.xml \
		gen-protocol/xdg-shell-protocol.h
	export CPATH="$PWD/gen-protocol${CPATH:+:$CPATH}"
	make
}

check() {
	cd "$pkgname/mixcomp"
	test -x mixcomp
	# mixcomp 未实现 --help,未知参数被忽略后直接进入事件循环;
	# 冒烟口径:timeout 内退出码 124(正常运行到被超时杀掉)或 0 算没炸,
	# 段错误(139)或其他异常退出算失败。
	export XDG_RUNTIME_DIR="$(mktemp -d)"
	rc=0
	# makepkg 以 set -e 跑 check(),timeout 非零退出必须就地接住
	timeout 5 ./mixcomp --help >/dev/null 2>&1 || rc=$?
	rm -rf "$XDG_RUNTIME_DIR"
	if [ "$rc" -eq 0 ] || [ "$rc" -eq 124 ]; then
		return 0
	fi
	# 0.18 迁移期宽限:历史上的启动段错误(虚拟 pointer 时序等六处坑)
	# 已修复(见 wayland-magic.md §8.1-8.6,71 分钟稳定运行);默认收紧,
	# 需要临时放宽时以 MIXCOMP_SMOKE_STRICT=0 构建。
	if { [ "$rc" -eq 139 ] || [ "$rc" -eq 134 ]; } &&
		[ "${MIXCOMP_SMOKE_STRICT:-1}" != "1" ]; then
		warning "mixcomp 冒烟段错误(exit=$rc)——MIXCOMP_SMOKE_STRICT=0 宽限通过"
		return 0
	fi
	echo "mixcomp 冒烟失败(exit=$rc)" >&2
	return 1
}

package() {
	cd "$pkgname/mixcomp"
	install -Dm755 mixcomp "$pkgdir/usr/bin/mixcomp"
	install -Dm644 README.md "$pkgdir/usr/share/doc/mixcomp/README.md"
}
