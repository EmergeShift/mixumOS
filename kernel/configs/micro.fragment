# linux-mixum-micro：VM guest 快路径（Apple Container / WSL2 / QEMU microVM）。
CONFIG_LOCALVERSION="-mixum-micro"

# Apple Virtualization / kata 都按 48-bit VA/PA 启动；defconfig 可能选 52-bit。
CONFIG_ARM64_VA_BITS_48=y
CONFIG_ARM64_VA_BITS=48
CONFIG_ARM64_PA_BITS_48=y
CONFIG_ARM64_PA_BITS=48

# ---- 模块 ----
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# ---- virtio（Apple Virtualization.framework / QEMU） ----
CONFIG_PCI=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_INPUT=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_UDMABUF=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y

# ---- Hyper-V / WSL 2 ----
CONFIG_HYPERV=y
CONFIG_HYPERV_VMBUS=y
CONFIG_HYPERV_STORAGE=y
CONFIG_HYPERV_NET=y
CONFIG_HYPERV_BALLOON=y
CONFIG_HYPERV_VSOCKETS=y
CONFIG_DRM_HYPERV=y

# ---- 控制台 / 调试 ----
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_VT=y
CONFIG_UNIX98_PTYS=y

# ---- 构建期不引入无关硬件 ----
# micro 的定位是“受控 guest”，不追求裸机硬件覆盖。
# 如需额外驱动，优先做成模块，用 fragment 追加，不要改 common。
