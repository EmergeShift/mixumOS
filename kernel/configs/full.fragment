# linux-mixum：完整镜像 / 通用 Linux VM / 裸机。
# 基底使用 Arch 内核 config；这里只补 mixumOS 需要的差异项。
CONFIG_LOCALVERSION="-mixum"

CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_COMPRESS_ZSTD=y

# 完整镜像也常跑在 QEMU/KVM 下：补齐 virtio 与 virtio-gpu。
CONFIG_PCI=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_INPUT=y
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_UDMABUF=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y

# 完整镜像需要串口控制台与常见硬件总线。
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_USB_SUPPORT=y
CONFIG_INPUT_EVDEV=y

# 固件加载：发行版内核通常已开；显式保留，避免裁掉无线/网卡固件。
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=y
