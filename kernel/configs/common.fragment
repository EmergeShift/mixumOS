# 两个内核共享的能力：CRIU / Landlock / FUSE / 资源与可观测性。
# 合并顺序：base.config + common.fragment + <variant>.fragment
# 关键项由 CI 的 kernel-config 断言检查（见 scripts/build.sh --verify-config）。

# ---- 快照与进程状态 ----
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_USERFAULTFD=y
CONFIG_EPOLL=y
CONFIG_MEMFD_CREATE=y

# ---- 文件系统隔离 ----
CONFIG_SECURITY_LANDLOCK=y
# 确保 landlock 在 LSM 链里；如果基底启用了 AppArmor/SELinux，按需追加。
CONFIG_LSM="landlock,lockdown,yama,integrity,bpf"
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# ---- 容器命名空间与资源 ----
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_TIME_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y

# ---- FUSE / 惰性挂载 ----
CONFIG_FUSE_FS=y
CONFIG_FUSE_PASSTHROUGH=y
CONFIG_VIRTIO_FS=y
CONFIG_OVERLAY_FS=y

# ---- 内存密度 ----
CONFIG_KSM=y
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP="zstd"
CONFIG_ZSMALLOC=y
CONFIG_ZSWAP=y
CONFIG_SWAP=y

# ---- eBPF / 可观测性 ----
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_PERF_EVENTS=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBE_EVENTS=y
CONFIG_FTRACE=y
CONFIG_TRACING=y
CONFIG_BPF_EVENTS=y
CONFIG_BPF_JIT=y
CONFIG_BPF_LSM=y
CONFIG_DEBUG_INFO=y
# CONFIG_DEBUG_INFO_REDUCED is not set
# CONFIG_DEBUG_INFO_SPLIT is not set
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y

# ---- 网络（容器 / 迁移） ----
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_NETFILTER=y
CONFIG_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IPV6=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y

# ---- 基础文件系统 ----
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_BLK_DEV_LOOP=y
